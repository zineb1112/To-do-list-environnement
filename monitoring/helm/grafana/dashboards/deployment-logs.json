{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {"expr": "{job=~\".*deployment.*|.*github.*\", deploymentId=~\"$deploymentId\"}", "refId": "A"}
      ],
      "title": "Deployment Logs",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLines": true,
        "sortOrder": "Descending",
        "deduplication": true
      }
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 2,
      "targets": [
        {"expr": "sum(count_over_time({deploymentId=~\".+\"} |~ \"(?i)failed|failure|error\" [15m]))", "refId": "A"}
      ],
      "title": "Deployment Failures",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 3,
      "targets": [
        {"expr": "sum(count_over_time({deploymentId=~\".+\"} |~ \"(?i)success|successful|completed\" [15m]))", "refId": "A"}
      ],
      "title": "Successful Deployments",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "deploymentId",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(deploymentId)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "title": "Deployment Logs",
  "uid": "deployment-logs"
}
